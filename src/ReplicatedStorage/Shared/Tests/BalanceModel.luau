--!strict
--[[
	BalanceModel
	A simulated player, run against the live config, for the §7 milestones.

	This is checked in because the previous version was not: the numbers in
	BALANCE.md came from a script that existed only in a Studio session, which
	made them unreproducible the moment that session closed. Every number this
	produces can now be regenerated by anyone with the repo.

		print(require(game.ReplicatedStorage.Shared.Tests.BalanceModel).run())

	What it is
	  The real config and the real shared Conversion module -- the same outcome
	  table, pity counter and mutation roll the server uses. Mining time is
	  computed analytically from pickaxe power against block HP rather than
	  simulated swing by swing.

	What it is not
	  A playthrough. The model never misclicks, never wanders, never stops to
	  read anything, and never gets bored. Treat every figure as a lower bound on
	  how long a person will take.

	Travel
	  The earlier model charged a flat 12s per round trip regardless of depth,
	  which is roughly right at Topsoil and badly wrong at 700 studs down. Travel
	  now scales with depth in both directions, and the two are not symmetric:
	  falling down a shaft is fast, climbing back up it is not. See TRAVEL below,
	  and `BalanceModel.run({ travel = "flat" })` to reproduce the old figures.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BrainrotConfig = require(ReplicatedStorage.Shared.Config.BrainrotConfig)
local Conversion = require(ReplicatedStorage.Shared.Modules.Conversion)
local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local LayerConfig = require(ReplicatedStorage.Shared.Config.LayerConfig)
local OreConfig = require(ReplicatedStorage.Shared.Config.OreConfig)
local Rarity = require(ReplicatedStorage.Shared.Modules.Rarity)
local ToolConfig = require(ReplicatedStorage.Shared.Config.ToolConfig)

local BalanceModel = {}

-- ==========================================================================
-- Model assumptions
-- ==========================================================================
--[[
	Everything in this section is an assumption about how a person behaves,
	not a fact about the game. They are gathered here so that arguing with the
	model means arguing with a named constant.
]]

local TRAVEL = {
	--[[
		Descending is mostly falling. Roblox gravity is 196.2 studs/s^2, so a
		clean 600-stud drop is under four seconds; the rest of the budget is
		lining the shaft up and not overshooting into the void catcher.
	]]
	DescentStudsPerSecond = 55,

	--[[
		Ascending is the expensive direction, and the reason this model changed.

		There is no lift, rope, or return-to-hub control anywhere in the game --
		the only teleport is MineService's void catcher, which fires below the
		mine floor and is a backstop rather than a route. So coming back up means
		jumping block to block: default JumpPower clears about 7.3 studs, a block
		is 4, and a jump-and-reposition cycle is roughly 0.9s. That is ~4.4
		studs/s. 7 is generous, on the assumption a player cuts a rough staircase
		on the way down and runs up parts of it.
	]]
	AscentStudsPerSecond = 7,

	-- Hub walking between the shaft mouth, the chamber, the plot and the shop.
	SurfaceSeconds = 12,

	-- Per menu interaction: one conversion roll, one purchase, one sale.
	MenuSeconds = 2,

	--[[
		Where in a band the player actually works. They arrive at the top of a
		newly unlocked layer and dig down through it, so the average trip is
		nearer the top than the middle.
	]]
	DepthWorkingFraction = 0.35,
}

-- The flat cost the previous model charged, kept so its figures can be
-- reproduced and the difference attributed.
local LEGACY_FLAT_TRIP_SECONDS = 12

local POLICY = {
	-- Stop buying upgrades once a rebirth is this close, and bank instead.
	RebirthSaveFraction = 0.6,

	--[[
		Buy the next layer unlock as soon as it is affordable, ahead of any tool.

		The old model bought whichever upgrade was cheapest, full stop. Run that
		way, the simulated player never leaves layer 2: tool tiers grow at
		CostGrowth (1.55x) from a 400-500 coin base, so the cheapest option stays
		under Ironvein's 28,000 until roughly tier 11 -- by which point it is
		banking for a rebirth instead. It reaches the first rebirth having seen
		two of the game's six layers.

		That is not a player. Layer unlocks are the largest coin sink in the game
		and the thing every other system is arranged around, and a real player
		buys the new place to dig long before the eleventh pickaxe. It also made
		the travel question unanswerable, since travel cost is a function of
		depth and the model never went deep.

		Set to false to reproduce the old behaviour.
	]]
	PreferLayerUnlock = true,

	-- Give up on a run after this much simulated time. A run that hits this is
	-- reported as a miss rather than quietly averaged in.
	MaxSimulatedSeconds = 8 * 60 * 60,

	-- Backstop against a policy bug turning into a hang.
	MaxSteps = 500000,
}

-- DESIGN.md §7, in minutes. `target = nil` means the doc sets no goal.
local TARGETS = {
	{ key = "firstConversion", label = "First conversion", target = 2 },
	{ key = "layerTwo", label = "Layer 2", target = 8 },
	{ key = "firstEpic", label = "First Epic+ brainrot", target = 20 },
	{ key = "firstRebirth", label = "First rebirth", target = 67.5 }, -- 60-75 midpoint

	--[[
		Past here the doc sets no targets, and these are reported for one
		reason: every §7 milestone above happens inside the top three layers,
		about 200 studs down, where travel is cheap either way. The question the
		travel model was rebuilt to answer -- whether the late game is
		unreasonably slow -- cannot be asked of a milestone that never leaves
		Stonecore. These are where depth actually costs something.
	]]
	{ key = "layerFour", label = "Layer 4 (Crystalis)", target = nil },
	{ key = "layerFive", label = "Layer 5 (Magmadeep)", target = nil },
	{ key = "layerSix", label = "Layer 6 (The Static)", target = nil },
}

-- ==========================================================================
-- Simulated player state
-- ==========================================================================

type Brainrot = {
	id: string,
	mutation: string,
	income: number,
}

type State = {
	rng: Random,
	elapsed: number,
	coins: number,
	rebirths: number,
	pickaxeTier: number,
	backpackTier: number,
	deepestLayer: number,
	plotSlots: number,
	oreCounts: { [string]: number },
	pityCounter: number,
	brainrots: { Brainrot },
	placedIncome: number,
	milestones: { [string]: number? },
	flatTravel: boolean,
	layerFirst: boolean,
	steps: number,
}

local function newState(seed: number, flatTravel: boolean, layerFirst: boolean): State
	return {
		rng = Random.new(seed),
		elapsed = 0,
		coins = 0,
		rebirths = 0,
		pickaxeTier = 1,
		backpackTier = 1,
		deepestLayer = 1,
		plotSlots = GameConfig.StartingPlotSlots,
		oreCounts = {},
		pityCounter = 0,
		brainrots = {},
		placedIncome = 0,
		milestones = {},
		flatTravel = flatTravel,
		layerFirst = layerFirst,
		steps = 0,
	}
end

local function mark(state: State, key: string)
	if state.milestones[key] == nil then
		state.milestones[key] = state.elapsed
	end
end

-- Time passes, and passive income accrues over it. Every place the model
-- consumes time goes through here, so income can never be forgotten.
local function advance(state: State, seconds: number)
	state.elapsed += seconds
	state.coins += state.placedIncome * seconds
end

local function rebirthMultiplier(state: State): number
	return ToolConfig.rebirthMultiplier(state.rebirths)
end

-- ==========================================================================
-- Mining
-- ==========================================================================

local function currentLayer(state: State)
	return LayerConfig.get(state.deepestLayer) or LayerConfig.LAYERS[1]
end

local function workingDepth(state: State): number
	local layer = currentLayer(state)
	return layer.minDepth + (layer.maxDepth - layer.minDepth) * TRAVEL.DepthWorkingFraction
end

--[[
	The two directions are charged separately because they are not remotely
	symmetric, and collapsing them into one round-trip number is most of what
	made the old model optimistic.
]]
local function descentSeconds(state: State): number
	if state.flatTravel then
		return LEGACY_FLAT_TRIP_SECONDS * 0.5
	end
	return workingDepth(state) / TRAVEL.DescentStudsPerSecond
end

local function ascentSeconds(state: State): number
	if state.flatTravel then
		return LEGACY_FLAT_TRIP_SECONDS * 0.5
	end
	return workingDepth(state) / TRAVEL.AscentStudsPerSecond
end

local function secondsToBreak(state: State, ore: any): number
	local layer = currentLayer(state)
	local pickaxe = ToolConfig.PICKAXES[state.pickaxeTier]
	local hp = GameConfig.BlockBaseHp * layer.hpMultiplier * ore.hardness
	local damage = pickaxe.power * rebirthMultiplier(state)
	local swings = math.ceil(hp / damage)
	return swings / pickaxe.swingsPerSecond
end

--[[
	One trip down: fill the backpack, then come back up. Returns nothing --
	everything lands in state.
]]
local function mineOneTrip(state: State)
	advance(state, descentSeconds(state))

	local capacity = ToolConfig.BACKPACKS[state.backpackTier].capacity
	local spawnTable = OreConfig.spawnTableForLayer(state.deepestLayer, state.rebirths)
	local carried = 0

	while carried < capacity do
		state.steps += 1
		if state.steps > POLICY.MaxSteps then
			break
		end

		local picked = Rarity.roll(spawnTable :: any, state.rng)
		if not picked then
			break
		end

		local ore = OreConfig.get(picked.id)
		if not ore then
			break
		end

		local yield = state.rng:NextInteger(GameConfig.OreYieldMin, GameConfig.OreYieldMax)
		local weight = ore.weightPerUnit * yield
		if carried + weight > capacity then
			-- The bag is full enough that the next block would not fit. A player
			-- heads up rather than mining a block they cannot carry.
			break
		end

		advance(state, secondsToBreak(state, ore))
		carried += weight
		state.oreCounts[ore.id] = (state.oreCounts[ore.id] or 0) + yield
	end

	advance(state, ascentSeconds(state))
end

-- ==========================================================================
-- Surface: convert, sell, place, buy
-- ==========================================================================

local function convertOnce(state: State, oreId: string)
	local cost = Conversion.cost()
	state.oreCounts[oreId] -= cost
	advance(state, TRAVEL.MenuSeconds)

	local entries = Conversion.outcomeTable(oreId)
	local picked, nextPity = Rarity.rollWithPity(entries, state.pityCounter, {
		threshold = GameConfig.PityThreshold,
		minimumRarity = GameConfig.PityMinimumRarity :: any,
	}, state.rng)
	state.pityCounter = nextPity

	if not picked then
		return
	end

	local mutation = Rarity.rollMap(Conversion.mutationTable(), state.rng) or "Normal"
	table.insert(state.brainrots, {
		id = picked.id,
		mutation = mutation,
		income = BrainrotConfig.incomeFor(picked.id, mutation),
	})

	mark(state, "firstConversion")
	if Rarity.atLeast(picked.rarity, "Epic") then
		mark(state, "firstEpic")
	end
end

--[[
	Roll while any single stack covers a roll, feeding the largest stack. Then
	sell everything except the largest remaining stack, which is held back as
	progress toward the next roll rather than cashed in -- carrying 19 units of
	an ore across a trip is worth more than the coins they would fetch.
]]
local function surfacePhase(state: State)
	local cost = Conversion.cost()

	-- Walking the hub between the shaft mouth, the chamber, the plot and the
	-- shop. Charged once per trip regardless of how many of them get used.
	advance(state, if state.flatTravel then 0 else TRAVEL.SurfaceSeconds)

	while true do
		local bestId, bestCount = nil, 0
		for id, count in state.oreCounts do
			if count > bestCount then
				bestId, bestCount = id, count
			end
		end

		if not bestId or bestCount < cost then
			break
		end
		convertOnce(state, bestId)
	end

	-- Hold back the largest sub-cost stack, sell the rest.
	local holdId, holdCount = nil, 0
	for id, count in state.oreCounts do
		if count > holdCount then
			holdId, holdCount = id, count
		end
	end

	local payout = 0
	local sold = 0
	for id, count in state.oreCounts do
		if id ~= holdId and count > 0 then
			local ore = OreConfig.get(id)
			if ore then
				payout += ore.baseValue * count
				sold += count
			end
			state.oreCounts[id] = 0
		end
	end

	if sold > 0 then
		state.coins += math.floor(payout * rebirthMultiplier(state))
		advance(state, TRAVEL.MenuSeconds)
	end
end

-- Podiums hold the highest-income brainrots owned, up to the slot count.
local function restackPodiums(state: State)
	table.sort(state.brainrots, function(a, b)
		return a.income > b.income
	end)

	local total = 0
	for index = 1, math.min(state.plotSlots, #state.brainrots) do
		total += state.brainrots[index].income
	end
	state.placedIncome = total * rebirthMultiplier(state)
end

--[[
	Buy the cheapest thing available, repeatedly, until nothing is affordable --
	except once a rebirth is within reach, at which point banking beats buying
	tools that the rebirth is about to take away.
]]
local function buyPhase(state: State)
	local rebirthCost = ToolConfig.rebirthCost(state.rebirths)

	while true do
		if state.coins >= rebirthCost * POLICY.RebirthSaveFraction then
			return
		end

		local bestPrice, bestKind = math.huge, nil

		local nextLayer = LayerConfig.get(state.deepestLayer + 1)

		-- Layer first, when the policy says so and the coins are there.
		if state.layerFirst and nextLayer and state.coins >= nextLayer.unlockCost then
			state.coins -= nextLayer.unlockCost
			advance(state, TRAVEL.MenuSeconds)
			state.deepestLayer += 1
			mark(state, "layerTwo")
			continue
		end

		if nextLayer and nextLayer.unlockCost < bestPrice then
			bestPrice, bestKind = nextLayer.unlockCost, "layer"
		end

		local nextPickaxe = ToolConfig.PICKAXES[state.pickaxeTier + 1]
		if nextPickaxe and nextPickaxe.price < bestPrice then
			bestPrice, bestKind = nextPickaxe.price, "pickaxe"
		end

		local nextBackpack = ToolConfig.BACKPACKS[state.backpackTier + 1]
		if nextBackpack and nextBackpack.price < bestPrice then
			bestPrice, bestKind = nextBackpack.price, "backpack"
		end

		local slotPrice = ToolConfig.plotSlotPrice(state.plotSlots)
		if slotPrice and #state.brainrots > state.plotSlots and slotPrice < bestPrice then
			bestPrice, bestKind = slotPrice, "slot"
		end

		if not bestKind or state.coins < bestPrice then
			return
		end

		state.coins -= bestPrice
		advance(state, TRAVEL.MenuSeconds)

		if bestKind == "layer" then
			state.deepestLayer += 1
			if state.deepestLayer >= 2 then
				mark(state, "layerTwo")
			end
		elseif bestKind == "pickaxe" then
			state.pickaxeTier += 1
		elseif bestKind == "backpack" then
			state.backpackTier += 1
		elseif bestKind == "slot" then
			state.plotSlots += 1
			restackPodiums(state)
		end
	end
end

-- ==========================================================================
-- One run
-- ==========================================================================

export type RunResult = {
	seed: number,
	milestones: { [string]: number? },
	elapsed: number,
	finalLayer: number,
	pickaxeTier: number,
	backpackTier: number,
	brainrots: number,
	incomePerSecond: number,
}

function BalanceModel.runOne(seed: number, flatTravel: boolean?, layerFirst: boolean?): RunResult
	local state = newState(seed, flatTravel == true, if layerFirst == nil then POLICY.PreferLayerUnlock else layerFirst)

	while state.elapsed < POLICY.MaxSimulatedSeconds and state.steps <= POLICY.MaxSteps do
		mineOneTrip(state)
		surfacePhase(state)
		restackPodiums(state)
		buyPhase(state)

		--[[
			Rebirth as soon as it is affordable. The multiplier applies to
			damage, income and sale value at once, so banking past the cost is
			strictly worse than taking it -- and the run has to continue past the
			first one, because everything below Crystalis happens after it.
		]]
		if state.coins >= ToolConfig.rebirthCost(state.rebirths) then
			if state.rebirths == 0 then
				mark(state, "firstRebirth")
			end

			state.rebirths += 1
			state.coins = 0
			state.pickaxeTier = 1
			state.backpackTier = 1
			table.clear(state.oreCounts)
			-- Kept: layers, brainrots, podium slots. See BALANCE.md's rebirth
			-- section -- wiping layer keys would make rebirth a punishment.
			restackPodiums(state)
		end

		if state.deepestLayer >= 4 then
			mark(state, "layerFour")
		end
		if state.deepestLayer >= 5 then
			mark(state, "layerFive")
		end
		if state.deepestLayer >= LayerConfig.COUNT then
			mark(state, "layerSix")
			break
		end
	end

	return {
		seed = seed,
		milestones = state.milestones,
		elapsed = state.elapsed,
		finalLayer = state.deepestLayer,
		pickaxeTier = state.pickaxeTier,
		backpackTier = state.backpackTier,
		brainrots = #state.brainrots,
		incomePerSecond = state.placedIncome,
	}
end

-- ==========================================================================
-- Reporting
-- ==========================================================================

local function minutes(seconds: number): number
	return seconds / 60
end

local function formatMinutes(value: number?): string
	if value == nil then
		return "not reached"
	end
	return string.format("%.1f", value)
end

export type Options = {
	seeds: number?,
	travel: string?, -- "depth" (default) or "flat"
	firstSeed: number?,
	layerFirst: boolean?, -- defaults to POLICY.PreferLayerUnlock
}

function BalanceModel.run(options: Options?): string
	local opts = options or {}
	local seedCount = opts.seeds or 12
	local firstSeed = opts.firstSeed or 1
	local flat = opts.travel == "flat"
	local layerFirst = if opts.layerFirst == nil then POLICY.PreferLayerUnlock else opts.layerFirst

	local results: { RunResult } = {}
	for index = 0, seedCount - 1 do
		table.insert(results, BalanceModel.runOne(firstSeed + index, flat, layerFirst))
	end

	local out: { string } = {}
	table.insert(
		out,
		`BalanceModel -- {seedCount} seeds, travel = {if flat then "flat 12s (legacy)" else "depth-scaled"}`
			.. `, buy policy = {if layerFirst then "layer unlocks first" else "cheapest first (legacy)"}`
	)
	table.insert(out, "")
	table.insert(out, "| Milestone | Target | Measured (avg) | Range | Ratio | Reached |")
	table.insert(out, "| --- | --- | --- | --- | --- | --- |")

	for _, milestone in TARGETS do
		local values: { number } = {}
		for _, result in results do
			local seconds = result.milestones[milestone.key]
			if seconds then
				table.insert(values, minutes(seconds))
			end
		end

		local targetCell = if milestone.target then `~{milestone.target} min` else "--"

		if #values == 0 then
			table.insert(out, `| {milestone.label} | {targetCell} | **not reached** | -- | -- | 0/{seedCount} |`)
		else
			local sum, low, high = 0, math.huge, -math.huge
			for _, value in values do
				sum += value
				low = math.min(low, value)
				high = math.max(high, value)
			end
			local average = sum / #values

			table.insert(
				out,
				string.format(
					"| %s | %s | **%.1f min** | %.1f-%.1f | %s | %d/%d |",
					milestone.label,
					targetCell,
					average,
					low,
					high,
					if milestone.target then string.format("%.2fx", average / milestone.target) else "--",
					#values,
					seedCount
				)
			)
		end
	end

	-- End-state summary, so a run that misses a milestone says why rather than
	-- leaving a blank cell to be guessed at.
	local finalLayer, pickaxe, backpack, brainrots, income, elapsed = 0, 0, 0, 0, 0, 0
	for _, result in results do
		finalLayer += result.finalLayer
		pickaxe += result.pickaxeTier
		backpack += result.backpackTier
		brainrots += result.brainrots
		income += result.incomePerSecond
		elapsed += result.elapsed
	end

	local n = #results
	table.insert(out, "")
	table.insert(out, "Average end state:")
	table.insert(
		out,
		string.format(
			"  layer %.1f, pickaxe tier %.1f, backpack tier %.1f, %.1f brainrots, %.1f coins/sec, after %.1f min",
			finalLayer / n,
			pickaxe / n,
			backpack / n,
			brainrots / n,
			income / n,
			minutes(elapsed / n)
		)
	)

	table.insert(out, "")
	table.insert(out, "Per-seed first rebirth (min):")
	local line = {}
	for _, result in results do
		table.insert(line, `{result.seed}:{formatMinutes(if result.milestones.firstRebirth then minutes(result.milestones.firstRebirth :: number) else nil)}`)
	end
	table.insert(out, "  " .. table.concat(line, "  "))

	return table.concat(out, "\n")
end

--[[
	The three configurations that matter, in the order that isolates each
	change: the old model, the old model with honest travel, and the current
	model. Run this after any config edit that moves the milestones, so the
	movement can be attributed rather than guessed at.
]]
function BalanceModel.compare(seeds: number?): string
	return table.concat({
		BalanceModel.run({ seeds = seeds, travel = "flat", layerFirst = false }),
		BalanceModel.run({ seeds = seeds, travel = "depth", layerFirst = false }),
		BalanceModel.run({ seeds = seeds, travel = "depth", layerFirst = true }),
	}, "\n\n")
end

--[[
	Exposed so the travel assumptions can be swept rather than argued about.
	AscentStudsPerSecond is the least defensible number in this file -- it is a
	guess about how fast a person climbs a shaft -- so the useful question is not
	"is 7 right" but "does the answer change if it isn't":

	    local Model = require(...BalanceModel)
	    for _, speed in { 4.4, 7, 16 } do
	        Model.TRAVEL.AscentStudsPerSecond = speed
	        print(speed, Model.run({ seeds = 12 }))
	    end

	Mutating this is a deliberate testing affordance and not thread-safe; put it
	back when you are done.
]]
BalanceModel.TRAVEL = TRAVEL
BalanceModel.POLICY = POLICY

return BalanceModel
